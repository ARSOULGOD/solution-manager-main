  "yaml": "# Sensitive fields are intentionally omitted. Edit them in Form View.\nfile:\n  sink:\n    general:\n      adapter_id: fm-file-sink\n      auto_create_directory: 1\n      dest_file_name_type: 3\n      storeBackupStateRemotely: false\n      state_backup_path: ./backup_state.cfg\n      clear_state_on_eod: 0\n      eod_time_sec: -1\n      alwaysVerifyData: true\n      alwaysMatchCompleteEvent: true\n    gcs:\n      enabled: 0\n      projectId: GCS_PROJECT_ID\n      credentialsFilePath: /home/centos/pubsubplus-connector-file-2.2.0/configs/gcs/creds.json\n      enableBulkComposeStrategy: true\n      retrySettings:\n        maxAttempts: 5\n        retryDelayMultiplier: 3\n        maxDurationMinutes: 2\n    sftp_settings:\n      enabled: 0\n      ip: SFTP_HOST_ADDRESS\n      port: 22\n      user: SFTP_USER\n      strictHostKeyChecking: 'no'\n    ftp_settings:\n      enabled: 0\n      ip: FTP_HOST_ADDRESS\n      port: 21\n      user: FTP_USER\n      secured: true\n    file_owner_permissions:\n      copy_source_file_mode_permissions: 0\n      copy_source_file_owner: 0\n      override_username: centos\n      override_group: centos\n    command_center:\n      enabled: 0\n      useOutputDestinationSolaceCredentials: true\n      solace_base_publish_topic: solace/dd/STORE-MANGEMENT/fa-assembler/cc/se/fa/assembler/Frankfurt\n      solace_messaging_mode: PERSISTENT\n      heartbeat_enabled: 0\n      heartbeat_interval: 3\n      solace_base_publish_topic_heartbeat: solace/dd/STORE-MANGEMENT/fa-assembler/cc/se/fa/assembler/Frankfurt\n      events:\n        fileStart: true\n        fileComplete: true\ncache:\n  CACHE_ENABLED: true\n  CACHE_PROVIDER: memory\n  CACHE_TTL: 5m\n  REDIS_URL: null\nserver:\n  port: 8094\n  ssl:\n    enabled: true\n    key-store: file:/home/banala/Music/entityFolders/download_binaries/SOURCE_NOSUBORG_Alice_FF_NWFILE_T3/keystore.p12\n    key-store-type: PKCS12\n    key-alias: myalias\nspring:\n  boot:\n    admin:\n      client:\n        instance:\n          prefer-ip: true\n          management-url: http://localIP:${server.port}/actuator\n          service-url: http://localIP:${server.port}/\n        enabled: true\n        url: http://50.17.36.43:9500/admin\n        auto-registration: true\n        prefer-ip: true\n        username: user\n  cloud:\n    stream:\n      bindings:\n        input-0:\n          destination: /home/banala/Music/entityFolders/updated/SOURCE_TEST_V1/file_paths.cfg\n          binder: file\n        output-0:\n          destination: file/test\n          binder: solace\n  application:\n    name: SOURCE_TEST_V1\nsolace:\n  connector:\n    security:\n      enabled: false\n    error:\n      handle: stop_all\n    workflows:\n      '0':\n        enabled: true\n        acknowledgment:\n          publish-async: true\n    management:\n      leader-election:\n        mode: standalone\n        fail-over:\n          max-attempts: 3\n          back-off-initial-interval: 1000\n          back-off-max-interval: 10000\n          back-off-multiplier: 2\n      queue: ''\n      session:\n        host: tcp://localhost:55555\n        msg-vpn: default\n        client-username: test\n  java:\n    host: tcp://localhost:55555\n    msg-vpn: default\n    client-username: test\n    connectRetries: -1\n    reconnectRetries: -1\nlogging:\n  level:\n    root: INFO\n    com:\n      solace:\n        connector:\n          jms: INFO\n          core: INFO\n        spring:\n          cloud:\n            stream:\n              binder: INFO\n      solacecoe:\n        spring:\n          cloud:\n            stream:\n              binders:\n                file: TRACE\n  file:\n    name: myapp.log\n  logback:\n    rollingpolicy:\n      file-name-pattern: ${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz\n      max-file-size: 100MB\n      max-history: 7\n      total-size-cap: 1GB\nmanagement:\n  security:\n    enabled: false\n  simple:\n    metrics:\n      export:\n        enabled: true\n  endpoints:\n    web:\n      exposure:\n        include: '*'\n      cors:\n        allowed-origins: '*'\n        allowed-methods: '*'\n        allowed-headers: '*'\n  endpoint:\n    logfile:\n      external-file: myapp.log\n    prometheus:\n      enabled: false\n    health:\n      show-details: ALWAYS\n      status:\n        order: DOWN,OUT_OF_SERVICE,RECONNECTING,UP,UNKNOWN\n",
