#!/usr/bin/env bash
# .githooks/pre-push — OR-22 frozen-migration guard, run LOCALLY before a push leaves this machine.
#
# This is the local half of OR-22's enforcement (see
# backend/cp-core/src/main/resources/db/migration/sm_control/README.md, "Publishing and freezing").
# The repo is a private GitHub repo on a free plan: branch protection / rulesets return 403, so
# nothing server-side can BLOCK a push or a merge. .github/workflows/migration-freeze.yml can only
# report a failing status after the fact. This hook is the only thing that can stop a bad push
# before it reaches origin — and it is OPT-IN and bypassable (`git push --no-verify`).
#
# Enable it with:
#   git config core.hooksPath .githooks
#
# Git invokes a pre-push hook as `pre-push <remote name> <remote URL>` and feeds it, on stdin, one
# line per ref being pushed:
#   <local ref> SP <local sha1> SP <remote ref> SP <remote sha1> LF
set -u

here="$(cd "$(dirname "$0")/.." && pwd)"
script="$here/backend/scripts/check-frozen-migrations.py"
zero="0000000000000000000000000000000000000000"
rc=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  if [ "$local_sha" = "$zero" ]; then
    # Deleting the remote ref — nothing new is being published.
    continue
  fi

  base=""
  if [ "$remote_sha" != "$zero" ] \
     && git -C "$here" rev-parse --verify --quiet "${remote_sha}^{commit}" >/dev/null 2>&1; then
    base="$remote_sha"
  elif git -C "$here" rev-parse --verify --quiet 'origin/main^{commit}' >/dev/null 2>&1; then
    # New remote branch (or the remote tip isn't available locally): fall back to the merge-base
    # with origin/main, the last published state we can be sure of.
    base="$(git -C "$here" merge-base "$local_sha" origin/main 2>/dev/null || true)"
  fi

  if [ -n "$base" ]; then
    out="$(python3 "$script" --head "$local_sha" --base "$base" 2>&1)"
  else
    out="$(python3 "$script" --head "$local_sha" 2>&1)"
  fi
  status=$?
  # `|` as the sed delimiter: `local_ref` (e.g. "refs/heads/x") contains "/", which would otherwise
  # collide with a "/"-delimited s/// and break the substitution.
  printf '%s\n' "$out" | sed "s|^|  [pre-push $local_ref] |"

  if [ "$status" -eq 1 ]; then
    echo "pre-push: BLOCKED — pushing $local_ref would violate OR-22 (see above). Use a new" \
         "migration instead of editing one that's already frozen." >&2
    rc=1
  elif [ "$status" -eq 2 ]; then
    echo "pre-push: NOTE — could not run the proposed-change check for $local_ref (nothing to" \
         "compare against); the immutable-anchor check still ran." >&2
  fi
done

exit $rc
