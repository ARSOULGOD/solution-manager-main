<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.solace.sm</groupId>
    <artifactId>backend-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>dp-api</artifactId>
  <name>Solution Manager :: dp-api</name>
  <description>Data-plane service interfaces (backend design §2). No dependencies by design.</description>

  <dependencies>
    <!-- Test only (redaction tests of the agw records). Versions come from the Spring Boot parent BOM (I2). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Publishes the agent-gateway port contract kits (dp-api test sources, plan 015 T2.1b) as dp-api-<version>-tests.jar so
        dp-core's ITs can extend them, as mesh-events already does for its own test sources. The kits are the one executable
        statement of what every implementation of a mutating dp.api.agw port must do. Version managed by the Boot parent (I2).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
