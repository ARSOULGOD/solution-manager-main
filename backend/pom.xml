<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Solution Manager backend — Maven reactor root.

    Stack per plan 001 Global Constraints: Java 17, Spring Boot 3.x, Maven (SM-D18).
    Module split per backend design §2 (BE-D3). Cross-plane boundary I7 is expressed
    twice: as the dependency edges below, and as ArchUnit rules in `arch-tests` that
    carry planted-violation proofs (a rule that cannot fire is decoration).

    Versions are resolved from Maven Central's own maven-metadata.xml, never from
    memory (I2). See docs/plans/backend/001-mesh-foundations-and-gates.md Task 8.

    `backend/spikes/` is deliberately NOT a module — the G1 spike is a throwaway
    Node/Docker harness, not part of this build.
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.solace.sm</groupId>
  <artifactId>backend-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Solution Manager :: backend</name>
  <description>Maven reactor root for the Solution Manager backend modules.</description>

  <!--
    Solution Manager is a Solace commercial product, not open source (owner ruling 2026-10-05, plan 010 T0.4b).
    The block is explicit so that no tool reads the Apache-2.0 the Spring Boot parent declares as OUR licence.
    There is deliberately no <url>: no licence-text URL exists to cite, and none is invented.
  -->
  <licenses>
    <license>
      <name>Proprietary - Solace</name>
      <distribution>manual</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>17</java.version>
    <archunit.version>1.5.0</archunit.version>
    <bouncycastle.version>1.86</bouncycastle.version>
    <!-- The agent wire: versions managed here; the executables' coordinates are spelled literally in agent-gateway/pom.xml (check-protoc-executables.py). -->
    <grpc.version>1.68.1</grpc.version>
    <protobuf.version>3.25.5</protobuf.version>

    <!--
      NOT cosmetic, and not a preference: sol-jcsmp (see dp-core's sol-jcsmp.version) requires
      netty 4.2.13.Final, while the Spring Boot 3.5.16 BOM manages netty at 4.1.135.Final and would
      otherwise DOWNGRADE it. That downgrade does not fail the build — it fails at runtime. JCSMP's
      transport classes reference io.netty.channel.MultiThreadIoEventLoopGroup,
      io.netty.channel.IoHandlerFactory, io.netty.channel.nio.NioIoHandler and
      io.netty.channel.epoll.EpollIoHandler (read out of the shipped jar with javap, not recalled),
      none of which exist in netty 4.1.x. Measured, not assumed: with the Boot version in force, the
      first connect dies with `NoClassDefFoundError: io/netty/channel/MultiThreadIoEventLoopGroup`.

      IT LIVES HERE, NOT IN dp-core, and that placement is the whole point. A <properties> override
      re-points the BOM only for the POM that declares it; it does NOT travel with the dependency.
      dp-core was the first version of this fix, and it left `arch-tests` — which has dp-core at test
      scope, and so resolves sol-jcsmp transitively — pulling netty 4.1.135.Final: two netty versions
      in one reactor, one of them the known-broken combination, invisible until something on that
      classpath actually opened a session. Real parent inheritance is what makes the override apply
      to every module that can ever end up with JCSMP on its path.

      Revisit when the Boot BOM's netty catches up to 4.2.x — at that point this property should be
      DELETED, not bumped, so the BOM resumes owning the version.
    -->
    <netty.version>4.2.13.Final</netty.version>
  </properties>

  <modules>
    <module>cp-api</module>
    <module>dp-api</module>
    <module>mesh-events</module>
    <module>cp-core</module>
    <module>dp-core</module>
    <module>agent-gateway</module>
    <module>console-gateway</module>
    <module>launcher</module>
    <!-- arch-tests last: it consumes every other module. -->
    <module>arch-tests</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Keeps the protobuf runtime locked to protoc 3.25.5 (T1.2 review finding 15). -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <!--
        Bouncy Castle, ONE version for all three artifacts (plan 015 T2.2 Step 4, P15-13, OR-127 L2). Revision 1 of the plan
        said no other Bouncy Castle artifact would resolve; that was false: dp-core resolved bcprov/bcpkix 1.80 and bcutil
        1.80.2 through sshj while cp-core resolved bcprov 1.86, so the launcher mixed bcprov 1.86 with bcpkix 1.80. Pinned here,
        every module that reaches any of them resolves exactly 1.86 (asserted by launcher's BouncyCastleSingleVersionTest and
        by the shipped dependency:tree of dp-core and launcher). The sshj suites run on 1.86.
      -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcutil-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>com.solace.sm</groupId>
        <artifactId>cp-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.solace.sm</groupId>
        <artifactId>dp-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.solace.sm</groupId>
        <artifactId>mesh-events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.solace.sm</groupId>
        <artifactId>cp-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.solace.sm</groupId>
        <artifactId>dp-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.solace.sm</groupId>
        <artifactId>agent-gateway</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.solace.sm</groupId>
        <artifactId>console-gateway</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.solace.sm</groupId>
        <artifactId>launcher</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        THE I8 DEPENDENCY LICENCE GATE (REQ-014, plan 010 T0.4b). Inherited by every jar module; the pom-packaging
        root is skipped by the plugin itself (acceptPomPackaging defaults to false). Runs in `verify` and ignores
        -DskipTests: it is a plugin goal, not a test.

        Two executions, because the scope of an approval is part of the approval:
          shipped  compile, runtime, provided, system  - what SM ships. Only the six allow-listed licences and
                                                          "Owner-approved (shipped)" / "Solace first-party" pass.
          test     test                                - additionally "Owner-approved (test-only)".
        An approval written for test or build tools only is a different licence NAME, so it fails the shipped
        execution if that artifact ever reaches a shipped scope. Build-tool-only approvals use a third name that
        no execution whitelists, so they fail in both.

        Every parameter that could weaken the gate is set explicitly here, because an explicit POM value beats a
        -Dlicense.* command-line property: failOnBlacklist and failOnMissing (both default false, so the
        plugin's default is a silent pass), force (default false: the plugin SKIPS an up-to-date report, which
        skips the check), useRepositoryMissingFiles (default true: licences supplied from outside the POM) and
        skipAddThirdParty. Exact-string only: licenseMerges entries, licence names and exception coordinates are
        never patterns. The artifact filters (excludedGroups and the like) are pinned to neutral values in the
        configuration below, because an unpinned filter is a bypass flag.

        What the plugin cannot do, and where it is covered:
          - several declared licences: the plugin passes on ANY one allow-listed (measured); the owner ruled
            Q-L2 (a'), fail closed -> licence-third-party.ftl aborts the build (<#stop>).
          - an exact version for an exception that does not change the licence name -> the same template.
          - build plugins and their own dependencies (not in project.getArtifacts(), measured): the second
            check, backend/scripts/check-licences.py. It is NOT bound to Maven.
          - system-scope dependencies (a jar named by file path has no POM; measured: a planted one passed the
            gate): refused by the same script, which fails on any <scope>system</scope> in a module pom.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.7.1</version>
        <configuration>
          <failOnBlacklist>true</failOnBlacklist>
          <failOnMissing>true</failOnMissing>
          <force>true</force>
          <skipAddThirdParty>false</skipAddThirdParty>
          <acceptPomPackaging>false</acceptPomPackaging>
          <includeTransitiveDependencies>true</includeTransitiveDependencies>
          <includeOptional>true</includeOptional>
          <useRepositoryMissingFiles>false</useRepositoryMissingFiles>
          <useMissingFile>false</useMissingFile>
          <deployMissingFile>false</deployMissingFile>
          <addOutputDirectoryAsResourceDir>false</addOutputDirectoryAsResourceDir>
          <generateBundle>false</generateBundle>
          <missingFile>${project.build.directory}/licence-gate/unused-missing-file.properties</missingFile>
          <licenseMergesUrl>file://${project.basedir}/../licence-allowlist.txt</licenseMergesUrl>
          <overrideUrl>file://${project.basedir}/../licence-exceptions.txt</overrideUrl>
          <fileTemplate>${project.basedir}/../licence-third-party.ftl</fileTemplate>
          <excludedLicenses/>
          <!--
            The artifact filters. Each has a -Dlicense.* user property and, unpinned, one command-line flag drops
            an artifact from the gate. Measured with the jna 5.13.0 election removed (a red build): each of
            -Dlicense.excludedGroups=net.java.dev, excludedArtifacts=jna, includedGroups=zzz, includedArtifacts=zzz,
            excludedTypes=jar, includedTypes=zzz and an artifactFiltersUrl file saying "exclude gaPattern
            net.java.dev.jna:jna" took it GREEN. Every one is pinned here, and each is re-measured red against the
            same mutation (see the README).
              excludedGroups, excludedArtifacts  never match. The plugin wraps the value as [^:]*(value)[^:]*, so an
                                                 anchor inside it can never match; (?!) is the explicit never-match.
              includedGroups, includedArtifacts  match everything. An include filter that is SET restricts the set,
                                                 so a never-match value here would check nothing (measured: an
                                                 anchored ^.*$ gave "The project has no dependencies" and a green
                                                 build; the report is compared with the unfiltered one).
              excludedTypes                      a type no artifact has. includedTypes: a comma list, not a regex.
                                                 A POM element left empty does NOT beat the flag (measured), so a
                                                 value is required. Types measured over the whole reactor with
                                                 dependency:list: jar and test-jar; pom and bundle are listed so a
                                                 legitimate type does not drop out. An artifact of any OTHER type is
                                                 not gated, which is a residual risk named in the README.
              artifactFiltersUrl                 the comment-only file licence-artifact-filters.txt.
          -->
          <excludedGroups>(?!)</excludedGroups>
          <excludedArtifacts>(?!)</excludedArtifacts>
          <excludedTypes>__none__</excludedTypes>
          <includedGroups>.*</includedGroups>
          <includedArtifacts>.*</includedArtifacts>
          <includedTypes>jar,test-jar,pom,bundle</includedTypes>
          <excludeTransitiveDependencies>false</excludeTransitiveDependencies>
          <artifactFiltersUrl>file://${project.basedir}/../licence-artifact-filters.txt</artifactFiltersUrl>
        </configuration>
        <executions>
          <execution>
            <id>licence-gate-shipped</id>
            <phase>verify</phase>
            <goals><goal>add-third-party</goal></goals>
            <configuration>
              <includedScopes>compile,runtime,provided,system</includedScopes>
              <excludedScopes>none</excludedScopes>
              <includedLicenses>
                <includedLicense>Apache-2.0</includedLicense>
                <includedLicense>MIT</includedLicense>
                <includedLicense>BSD-2-Clause</includedLicense>
                <includedLicense>BSD-3-Clause</includedLicense>
                <includedLicense>ISC</includedLicense>
                <includedLicense>PostgreSQL</includedLicense>
                <includedLicense>Owner-approved (shipped)</includedLicense>
                <includedLicense>Solace first-party</includedLicense>
              </includedLicenses>
              <outputDirectory>${project.build.directory}/licence-gate/shipped</outputDirectory>
              <thirdPartyFilename>THIRD-PARTY-shipped.txt</thirdPartyFilename>
            </configuration>
          </execution>
          <execution>
            <id>licence-gate-test</id>
            <phase>verify</phase>
            <goals><goal>add-third-party</goal></goals>
            <configuration>
              <includedScopes>test</includedScopes>
              <excludedScopes>none</excludedScopes>
              <includedLicenses>
                <includedLicense>Apache-2.0</includedLicense>
                <includedLicense>MIT</includedLicense>
                <includedLicense>BSD-2-Clause</includedLicense>
                <includedLicense>BSD-3-Clause</includedLicense>
                <includedLicense>ISC</includedLicense>
                <includedLicense>PostgreSQL</includedLicense>
                <includedLicense>Owner-approved (shipped)</includedLicense>
                <includedLicense>Solace first-party</includedLicense>
                <includedLicense>Owner-approved (test-only)</includedLicense>
              </includedLicenses>
              <outputDirectory>${project.build.directory}/licence-gate/test</outputDirectory>
              <thirdPartyFilename>THIRD-PARTY-test.txt</thirdPartyFilename>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
