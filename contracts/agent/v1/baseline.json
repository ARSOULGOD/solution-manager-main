 },
 "options": {
  "go_package": "\"github.com/solace/solution-manager/go-agent/internal/wire/pb;pb\""
 },
 "package": "solace.sm.agentgateway.v1draft",
 "services": {
  "AgentGateway": {
   "Connect": "stream AgentToGateway -> stream GatewayToAgent",
   "Enroll": "EnrollRequest -> EnrollResponse",
   "Telemetry": "stream TelemetryUp -> stream TelemetryDown"
  }
 },
 "syntax": "\"proto3\""
}
