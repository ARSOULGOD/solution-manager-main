# Copy to .env and fill in every empty value. There are no defaults: compose refuses to start (`:?`) while any is left empty.
SM_IMAGE=sm-launcher:dev

# Database passwords are NOT set here (OR-138): run scripts/init-secrets.sh once; it writes the superuser and the four role
# passwords (control/data x migrator/runtime) as files in ./secrets, which compose delivers as secrets. Optional: point
# SM_SECRETS_DIR at another directory. Compose and scripts/init-secrets.sh both read it from THIS file (a relative value is
# relative to this directory); the script also honours it from the environment, but sudo drops that, so prefer setting it here.
# SM_SECRETS_DIR=./secrets

# Label of the data-plane master key (A-Z a-z 0-9 . _ -, up to 64). The key itself is secrets/dp_master_key, written by scripts/init-secrets.sh;
# BACK IT UP like a key: losing it loses every sealed secret value. Keep the label stable; change it only with a key rotation.
SM_DP_MASTER_KEY_ID=

# Argon2id hash of the single-use bootstrap administrator secret (never the plaintext).
SM_CONTROL_BOOTSTRAP_CREDENTIAL_HASH=

# The exact scheme://host[:port] origin(s) browsers use to reach the console.
SM_TRUSTED_ORIGIN=https://console.example.test

# The address the TLS reverse proxy's connections arrive from, as the launcher container sees it (OR-136 (4)).
# A proxy on the Docker host arrives from the compose network's gateway address, not 127.0.0.1.
SM_TRUSTED_PROXY=

# host:port that ENROLLED agents are told to dial (must be covered by the gateway server certificate's subjectAltName).
SM_AGENT_ENDPOINT=sm.example.test:9443
# Optional. Lifetimes are Spring durations (24h, 30d). Defaults shown; the launcher refuses to start when the token default exceeds the max.
# SM_AGENT_CA_LEAF_TTL=30d
# SM_AGENT_ENROLMENT_TOKEN_DEFAULT_VALIDITY=24h
# SM_AGENT_ENROLMENT_TOKEN_MAX_VALIDITY=30d
# SM_AGENT_SWEEP_ENABLED=true
# SM_AGENT_SWEEP_INTERVAL=PT1M
# SM_AGENT_STALENESS_JOB_ENABLED=true
# SM_AGENT_STALENESS_JOB_INTERVAL=PT30S
# The CA keystore, its password and the gateway key are NOT set here: they are files under ./certs (see compose.yml, "Secrets").
