#!/bin/sh
# One-shot: Phase 1 of both schemas as the MIGRATOR roles, in separate JVMs from the application (the application is never
# given a migrator credential). Reads, per schema, the variables the migration mains document:
#   SM_CONTROL_MIGRATOR_URL / _USERNAME / _PASSWORD and SM_CONTROL_BOOTSTRAP_CREDENTIAL_HASH
#   SM_DATA_MIGRATOR_URL    / _USERNAME / _PASSWORD
# The two passwords arrive as files (OR-138): SM_CONTROL_MIGRATOR_PASSWORD_FILE / SM_DATA_MIGRATOR_PASSWORD_FILE (compose
# secrets), read by sm-secrets.sh, and each JVM is given only its own schema's password. Nothing is echoed or put in argv.
# Exit status is the first failing step's.
set -eu
set -f   # $JAVA_OPTS is split into words on purpose; it must not glob
SM_PROG=sm-migrate
. "$(dirname "$0")/sm-secrets.sh"
sm_load_secret SM_CONTROL_MIGRATOR_PASSWORD
sm_load_secret SM_DATA_MIGRATOR_PASSWORD
run() { java $JAVA_OPTS -cp /opt/sm/launcher.jar -Dloader.main="$1" org.springframework.boot.loader.launch.PropertiesLauncher; }
runlast() { exec java $JAVA_OPTS -cp /opt/sm/launcher.jar -Dloader.main="$1" org.springframework.boot.loader.launch.PropertiesLauncher; }
echo "sm-migrate: sm_control"
( unset SM_DATA_MIGRATOR_PASSWORD; run com.solace.sm.cp.persistence.SmControlMigrationMain )
echo "sm-migrate: sm_data"
unset SM_CONTROL_MIGRATOR_PASSWORD
runlast com.solace.sm.dp.apply.persistence.SmDataMigrationMain
