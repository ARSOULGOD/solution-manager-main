{
  "name": "@solution-manager/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/assert-echarts-chunk.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fixtures": "eslint src/test/lint-fixtures --no-ignore --max-warnings=0",
    "lint:fixtures:assert": "node scripts/assert-lint-fixtures.mjs",
    "check:forbidden-deps": "node scripts/check-forbidden-deps.mjs",
    "generate:types": "node scripts/generate-types.mjs",
    "test": "vitest run",
    "test:a11y": "node scripts/test-a11y.mjs",
    "e2e": "playwright test",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:csp": "node scripts/verify-csp.mjs",
    "verify:palette": "node scripts/validate-palette.mjs",
    "verify:reflow": "node scripts/verify-reflow.mjs",
    "verify:production": "node scripts/verify-production-build.mjs",
    "verify:perf": "node scripts/verify-perf.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@mui/x-data-grid": "^9.11.0",
    "@tanstack/react-query": "^5.101.4",
    "ajv": "^8.20.0",
    "echarts": "^6.1.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^24.0.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
