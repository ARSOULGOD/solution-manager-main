{
  "solution": "cache",
  "packageVersion": [
    6,
    7
  ],
  "appliesTo": ">=2.2 <2.5",
  "provenance": {
    "author": "solace",
    "signature": "3af9\u2026c210"
  },
  "authoring": {
    "reviewedRows": 1494,
